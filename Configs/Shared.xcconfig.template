// 이 파일을 같은 폴더에 Shared.xcconfig 로 복사한 뒤 자기 팀 ID를 넣는다.
// (Shared.xcconfig 는 개인/환경별 값이라 git에 올리지 않음)

// 백엔드 서버 환경 (서버 주소는 공개하지 않는다 — 팀 채널에서 받아 아래에 채운다)
// 값을 바꾼 뒤에는 `mise exec -- tuist generate`를 다시 실행해야 baseURL과 ATS 예외에 반영된다.
// HTTPS 전환 시: API_SCHEME을 https로 바꾸고 API_PORT를 비우면 ATS 예외가 자동으로 사라진다.
API_SCHEME = http
API_HOST = YOUR_API_HOST
API_PORT = 8080

// Apple Developer 팀 ID (Xcode > Settings > Accounts 에서 확인)
DEVELOPMENT_TEAM = YOUR_TEAM_ID

// 카카오 로그인 네이티브 앱 키 (카카오 개발자 콘솔 > 앱 > 앱 키)
KAKAO_NATIVE_APP_KEY = YOUR_KAKAO_NATIVE_APP_KEY
